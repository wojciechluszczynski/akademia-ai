{
  "rewrites": [
    { "source": "/api/create-checkout", "destination": "/api/create-checkout.js" },
    { "source": "/api/webhook",         "destination": "/api/webhook.js" },
    { "source": "/api/cert",            "destination": "/api/cert.js" },
    { "source": "/",                    "destination": "/index.html" },
    { "source": "/login",               "destination": "/login.html" },
    { "source": "/register",            "destination": "/register.html" },
    { "source": "/dashboard",           "destination": "/dashboard.html" },
    { "source": "/verify",              "destination": "/verify.html" },
    { "source": "/cert",               "destination": "/cert-view.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    },
    {
      "source": "/vault/(.*)\\.md",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Type",        "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/vault/(.*)\\.json",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Type",        "value": "application/json" }
      ]
    },
    {
      "source": "/audio/(.*)\\.mp3",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
